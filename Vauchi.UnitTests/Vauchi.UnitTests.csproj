<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- LibraryImport source-generated stubs compile to unsafe blocks. The
         main Vauchi.csproj enables this; the test project links VauchiNative.cs
         directly (via <Compile Include="..\Vauchi\Interop\VauchiNative.cs">)
         so it needs the same opt-in. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);UNIT_TEST_BUILD</DefineConstants>
    <IsPackable>false</IsPackable>
    <!-- Suppress WindowsAppSDK PRI/MRT tooling (requires VS tools not present in dotnet CLI) -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <!-- Xunit v2 has no dynamic Assert.Skip (v3 only); SkippableFact fills the gap
         so KeyStorageServiceTests report an explicit skip instead of silent-pass
         when PasswordVault needs an interactive Windows session (private#1129). -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.*" />
    <PackageReference Include="JunitXml.TestLogger" Version="4.*" />
    <PackageReference Include="coverlet.collector" Version="6.*" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- The hardware shell, pinned exactly (ADR-077 D-3), as the app pins it. -->
    <PackageReference Include="Vauchi.Contract" Version="[0.101.0]" />
    <PackageReference Include="vauchi-windows-hw" Version="[0.7.0]" />
    <PackageReference Include="vauchi-windows-hw-native" Version="[0.7.0]" />
    <PackageReference Include="vauchi-windows-hw-notifications" Version="[0.7.0]" />
    <!-- The display shell the app assembles; its own tests live in
         windows-display, these test the app around it. -->
    <PackageReference Include="vauchi-windows-display" Version="[0.2.0]" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.9" />
  </ItemGroup>
  <!-- Link helper files from main project -->
  <ItemGroup>
    <Compile Include="..\Vauchi\Interop\VauchiNative.cs" Link="Linked\VauchiNative.cs" />
    <Compile Include="..\Vauchi\Interop\CabiEngineLink.cs" Link="Linked\CabiEngineLink.cs" />
    <Compile Include="..\Vauchi\Hardware\HardwareBridge.cs" Link="Linked\HardwareBridge.cs" />
    <Compile Include="..\Vauchi\Hardware\WindowsHardware.cs" Link="Linked\WindowsHardware.cs" />
    <Compile Include="..\Vauchi\MainWindow.xaml.cs" Link="Linked\MainWindow.xaml.cs" />
    <Compile Include="..\Vauchi\MainWindowEffects.cs" Link="Linked\MainWindowEffects.cs" />
    <Compile Include="..\Vauchi\MainWindowState.cs" Link="Linked\MainWindowState.cs" />
    <Compile Include="..\Vauchi\Platform\DeepLinks.cs" Link="Linked\DeepLinks.cs" />
    <Compile Include="..\Vauchi\Platform\KeyStorageService.cs" Link="Linked\KeyStorageService.cs" />
    <Compile Include="..\Vauchi\Platform\NetworkCost.cs" Link="Linked\NetworkCost.cs" />
    <Compile Include="..\Vauchi\Platform\SecureStorageService.cs" Link="Linked\SecureStorageService.cs" />
    <Compile Include="..\Vauchi\Platform\SystemLocale.cs" Link="Linked\SystemLocale.cs" />
    <Compile Include="..\Vauchi\Platform\SystemTrayManager.cs" Link="Linked\SystemTrayManager.cs" />
    <Compile Include="..\Vauchi\Services\Localizer.cs" Link="Linked\Localizer.cs" />
    <Compile Include="..\Vauchi\Services\ScreenCaptureProtection.cs" Link="Linked\ScreenCaptureProtection.cs" />
  </ItemGroup>
</Project>
