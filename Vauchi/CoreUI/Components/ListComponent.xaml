<UserControl
    x:Class="Vauchi.CoreUI.Components.ListComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <!-- TODO(HUMBLE): W — hardcoded "Search contacts" placeholder and ContactContainer name; core should supply placeholder/label and component should use generic list terms (see _private/docs/problems/2026-07-06-desktop-tui-web-domain-shell-violations). -->
