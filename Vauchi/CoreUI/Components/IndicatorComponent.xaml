<UserControl
    x:Class="Vauchi.CoreUI.Components.IndicatorComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Chip"
            CornerRadius="12"
            Padding="8,4"
            HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse x:Name="KindDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelText" Text="[Indicator placeholder]" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
