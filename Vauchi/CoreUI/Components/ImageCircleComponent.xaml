<UserControl
    x:Class="Vauchi.CoreUI.Components.ImageCircleComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AvatarContainer"
          Width="96" Height="96"
          HorizontalAlignment="Center"
          CornerRadius="48">
        <!-- Fallback initials circle -->
        <Ellipse x:Name="InitialsCircle"
                 Width="96" Height="96" />
        <TextBlock x:Name="InitialsText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="White" />

        <!-- Image avatar (hidden until image_data is present) -->
        <Ellipse x:Name="ImageCircle"
                 Width="96" Height="96"
                 Visibility="Collapsed">
            <Ellipse.Fill>
                <ImageBrush x:Name="AvatarImageBrush"
                            Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>

        <!-- Native keyboard/pointer edit affordance (shown only when core
             supplies edit_action_id). -->
        <Button x:Name="EditButton"
                Visibility="Collapsed"
                Width="96" Height="96"
                Padding="0"
                BorderThickness="0"
                Background="#40000000"
                CornerRadius="48">
            <FontIcon Glyph="&#xE722;"
                      FontSize="20"
                      Foreground="White"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Button>
    </Grid>
</UserControl>
