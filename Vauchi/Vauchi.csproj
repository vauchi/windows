<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
	  <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	  <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion>
	  <Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <WindowsPackageType>None</WindowsPackageType>
	  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.9" />
  </ItemGroup>
  <!-- Design tokens — vendored from themes/generated/Tokens.cs
       Regenerate: cp themes/generated/Tokens.cs windows/Vauchi/CoreUI/Tokens.cs
       File is auto-included by SDK default globbing (no explicit Compile needed) -->
  <!-- Brand font files (OFL-1.1) — vendored verbatim from themes/fonts,
       see REUSE.toml for per-family copyright -->
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- MSIX tiles named by packaging/Package.appxmanifest (private#589) -->
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Pictograms — vendored verbatim from assets/pictograms/<group>/generated/svg.
       Pictograms.Resolve reads them back by logical name, so a new drawing
       needs no code. Regenerate: cp ../assets/pictograms/exchange/generated/svg/*.svg
       Vauchi/Assets/Pictograms/exchange/ -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Pictograms\**\*.svg"
                      LogicalName="Vauchi.Pictograms/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- CABI native library — copied to output when present -->
  <ItemGroup>
    <!-- Relative to this file, not $(SolutionDir): building the project on
         its own (snapshot app, package:msix) leaves SolutionDir undefined,
         so the DLL was silently left out (private#635). -->
    <None Include="$(MSBuildThisFileDirectory)..\cabi\vauchi_cabi.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="vauchi_cabi.dll"
          Visible="false"
          Condition="Exists('$(MSBuildThisFileDirectory)..\cabi\vauchi_cabi.dll')" />
  </ItemGroup>
  <!-- Locale JSON files — copied to $(OutDir)/locales/ for Localizer.Init()
       (CABI vauchi_i18n_init). Default source: the vauchi/locales checkout
       next to this repo; CI clones it and sets LocalesDir. A build without
       them showed raw keys everywhere, so it now fails (private#635). -->
  <PropertyGroup>
    <LocalesDir Condition="'$(LocalesDir)' == ''">$(MSBuildThisFileDirectory)..\..\locales</LocalesDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(LocalesDir)\*.json"
             Exclude="$(LocalesDir)\locales.schema.json"
             CopyToOutputDirectory="PreserveNewest"
             Link="locales\%(Filename)%(Extension)"
             Visible="false" />
  </ItemGroup>
  <Target Name="RequireLocales" BeforeTargets="Build">
    <Error Condition="!Exists('$(LocalesDir)\en.json')"
           Text="No locales at $(LocalesDir) (en.json missing): clone vauchi/locales next to this repo, or set LocalesDir. Without them the app shows raw keys." />
  </Target>
</Project>
