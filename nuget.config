<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-FileCopyrightText: 2026 Mattia Egloff <mattia.egloff@pm.me>
SPDX-License-Identifier: GPL-3.0-or-later

Restore reads package sources from the *account's* NuGet.Config when the
repo has none. That made the build depend on ambient machine state: it
worked on GitLab's SaaS Windows images, which ship a default config, and
failed on pam with NU1100 for all 56 packages — Microsoft's own runtime
packs included — because a freshly provisioned account has no sources at
all (job 16461294262; `dotnet nuget list source` printed "No sources
found.", job 16461804947).

<clear /> makes the set explicit rather than inherited, so every runner
restores from the same place.

Vauchi.Contract, the hardware shell and the display shell come from their
projects' package registries, addressed by number (88365544 is
vauchi/contract, 88343324 is vauchi/windows-hw, 89329658 is
vauchi/windows-display): the registry answers "id is invalid" to a
project's path. All are public and need no credential. packageSourceMapping keeps
each package on its one source, so a same-named package elsewhere is
never taken.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="vauchi-contract" value="https://gitlab.com/api/v4/projects/88365544/packages/nuget/index.json" protocolVersion="3" />
    <add key="vauchi-windows-hw" value="https://gitlab.com/api/v4/projects/88343324/packages/nuget/index.json" protocolVersion="3" />
    <add key="vauchi-windows-display" value="https://gitlab.com/api/v4/projects/89329658/packages/nuget/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vauchi-contract">
      <package pattern="Vauchi.Contract" />
    </packageSource>
    <packageSource key="vauchi-windows-hw">
      <package pattern="vauchi-windows-hw" />
      <package pattern="vauchi-windows-hw-native" />
      <package pattern="vauchi-windows-hw-notifications" />
    </packageSource>
    <packageSource key="vauchi-windows-display">
      <package pattern="vauchi-windows-display" />
    </packageSource>
  </packageSourceMapping>
</configuration>
