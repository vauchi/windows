<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion>
    <!-- A WinUI test project must declare RuntimeIdentifiers and initialize the
         WindowsAppSDK bootstrap; without a RID the testhost builds to the no-RID
         output while the referenced app builds to win-x64\, so vstest cannot load
         Microsoft.TestPlatform.CoreUtilities. `dotnet test` selects with -r win-x64.
         https://learn.microsoft.com/windows/apps/develop/testing/ -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vauchi\Vauchi.csproj" />
  </ItemGroup>
</Project>
